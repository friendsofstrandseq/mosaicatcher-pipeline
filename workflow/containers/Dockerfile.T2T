# Assembly-specific Dockerfile for T2T (CHM13v2.0)
# Extends base image with BSgenome.Hsapiens.UCSC.hs1 (Bioconductor package for T2T-CHM13v2.0)

FROM mosaicatcher:base

LABEL assembly="T2T"
LABEL bsgenome="BSgenome.Hsapiens.UCSC.hs1"
LABEL org.opencontainers.image.description="MosaiCatcher Pipeline for Human T2T-CHM13v2.0 assembly. Includes BSgenome.Hsapiens.UCSC.hs1 for structural variant calling from single-cell Strand-seq data."

# Find R environment via Rscript binary and install BSgenome
RUN echo "=== Finding R environment ===" && \
    RSCRIPT_PATH=$(find /conda-envs -name "Rscript" -type f -path "*/bin/Rscript" -not -path "*/lib/R/*" | head -1) && \
    echo "Found Rscript at: $RSCRIPT_PATH" && \
    RTOOLS_ENV=$(dirname $(dirname "$RSCRIPT_PATH")) && \
    echo "R environment path: $RTOOLS_ENV" && \
    echo "" && \
    echo "=== Installing BSgenome.Hsapiens.UCSC.hs1 via conda ===" && \
    /opt/conda/bin/conda install -p "$RTOOLS_ENV" -y -c bioconda bioconductor-bsgenome.hsapiens.ucsc.hs1 && \
    /opt/conda/bin/conda clean --all -y && \
    echo "=== Installation complete ==="

# Verify installation
RUN echo "=== Verifying BSgenome installation ===" && \
    RSCRIPT_PATH=$(find /conda-envs -name "Rscript" -type f | head -1) && \
    echo "Using Rscript at: $RSCRIPT_PATH" && \
    "$RSCRIPT_PATH" -e 'library(BSgenome.Hsapiens.UCSC.hs1); print(BSgenome.Hsapiens.UCSC.hs1)'
